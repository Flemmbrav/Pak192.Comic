# "Die ab 1908 eingeführten Schlafwagen der Type R (für „Règle“) wurden mit 16 oder 18 Betten gebaut." ~ https://de.wikipedia.org/wiki/CIWL-Teakholzwagen
payload=16
cost=5037648
runningcost=45
# weigth estimated
weight=30
#
speed=100
